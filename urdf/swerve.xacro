    </geometry>
  </collision>
</link>

<joint name="swerve2" type="revolute">
  <origin xyz="-0.27 0.155885 0.015" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="swerve_stare_v3_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
  <limit upper="3.141593" lower="-3.141593" effort="100" velocity="100"/>
</joint>

<joint name="swerve1" type="revolute">
  <origin xyz="0.27 0.155885 0.015" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="swerve_stare_v3_2"/>
  <axis xyz="0.0 0.0 -1.0"/>
  <limit upper="3.141593" lower="-3.141593" effort="100" velocity="100"/>
</joint>

<joint name="swerve3" type="revolute">
  <origin xyz="0.0 -0.311769 0.015" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="swerve_stare_v3_3"/>
  <axis xyz="0.0 0.0 -1.0"/>
  <limit upper="3.141593" lower="-3.141593" effort="100" velocity="100"/>
</joint>

<joint name="wheel2" type="continuous">
  <origin xyz="0.0 0.0 -0.01" rpy="0 0 0"/>
  <parent link="swerve_stare_v3_1"/>
  <child link="swerve_wheel_v4_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="wheel1" type="continuous">
  <origin xyz="0.0 0.0 -0.01" rpy="0 0 0"/>
  <parent link="swerve_stare_v3_2"/>
  <child link="swerve_wheel_v4_2"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="wheel3" type="continuous">
  <origin xyz="0.0 0.0 -0.01" rpy="0 0 0"/>
  <parent link="swerve_stare_v3_3"/>
  <child link="swerve_wheel_v4_3"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="rigit8" type="fixed">
  <origin xyz="0.0 0.05 0.07" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="mid-360-asm_v3_1"/>
</joint>


<gazebo reference="mid-360-asm_v3_1">
  <sensor type="gpu_lidar" name="lidar_sensor">
    <ignition_frame_id>base_link</ignition_frame_id>
    <topic>/lidar</topic>
    <alwaysOn>1</alwaysOn>
    <visualize>true</visualize>
    <update_rate>10</update_rate>
    <ray>
      <scan>
        <horizontal>
          <samples>720</samples>
          <min_angle>-3.14</min_angle>
          <max_angle> 3.14</max_angle>
        </horizontal>
        <vertical>
          <samples>28</samples>
          <min_angle>-0.1221730476396</min_angle>
          <max_angle>0.90757121103706</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.1</min>
        <max>40.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre</render_engine>
    </plugin>
  </sensor>
</gazebo>


<gazebo>
<plugin filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
  <joint_name>swerve1</joint_name>
  <topic>/pos_1</topic>
  <p_gain>1</p_gain>
  <i_gain>0.1</i_gain>
  <d_gain>0.01</d_gain>
</plugin>
<plugin filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
  <joint_name>swerve2</joint_name>
  <topic>/pos_2</topic>
  <p_gain>1</p_gain>
  <i_gain>0.1</i_gain>
  <d_gain>0.01</d_gain>
</plugin>
<plugin filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
  <joint_name>swerve3</joint_name>
  <topic>/pos_3</topic>
  <p_gain>1</p_gain>
  <i_gain>0.1</i_gain>
  <d_gain>0.01</d_gain>
</plugin>
</gazebo>

</robot>
