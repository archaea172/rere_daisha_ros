<?xml version="1.0" ?>
<robot name="swerve" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find rere_daisha_ros)/urdf/materials.xacro" />
<xacro:include filename="$(find rere_daisha_ros)/urdf/swerve.trans" />

<link name="base_root"/>

<joint name="base_root_to_base_link" type="fixed">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="base_root"/>
  <child link="base_link"/>
</joint>

<link name="base_link">
