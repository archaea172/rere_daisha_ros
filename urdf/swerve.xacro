<link name="mid-360-asm_v3_1">
  <inertial>
    <origin xyz="-0.001104909225108346 -1.70411760137823e-05 0.03018469043134761" rpy="0 0 0"/>
    <mass value="0.4113191807928639"/>
    <inertia ixx="0.000237" iyy="0.000251" izz="0.000164" ixy="-0.0" iyz="-0.0" ixz="-7e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.05 -0.07" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://rere_daisha_ros/meshes/mid-360-asm_v3_1.stl" scale="1 1 1"/>
    </geometry>
